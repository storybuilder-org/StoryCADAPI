<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Until StoryCAD 4.4 ships: built from a sibling StoryCAD checkout (dev), because the
         Collaborator tools need code no released StoryCADLib has (Collaborator #291). -->
    <ProjectReference Include="../../StoryCAD/StoryCADLib/StoryCADLib.csproj" />
    <ProjectReference Include="../../StoryCAD/CollaboratorLib/CollaboratorLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoryCADMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
