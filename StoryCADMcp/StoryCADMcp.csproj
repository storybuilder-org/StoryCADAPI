<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../StoryCAD/StoryCADLib/StoryCADLib.csproj"
                      Condition="'$(UseStoryCADLibNuGet)' != 'true'" />
    <PackageReference Include="StoryCADLib" Version="$(StoryCADLibVersion)" ExcludeAssets="contentFiles"
                      Condition="'$(UseStoryCADLibNuGet)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
</Project>
