<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Outliner.ContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="600"
    Height="800">

        <!-- Top Area: Existing Controls -->
        <StackPanel Orientation="Vertical" Margin="10">
            <!-- Old Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Read Story" Command="{x:Bind PageVm.ReadStoryCommand}" Margin="5"/>
                <Button Content="Output File" Command="{x:Bind PageVm.OutputFileCommand}" Margin="5"/>
                <Button Content="Create Outline" Command="{x:Bind PageVm.CreateOutlineCommand}" Margin="5"/>
                <ProgressRing IsActive="{x:Bind PageVm.IsProcessing, Mode=OneWay}"
                              Width="24" Height="24"
                              VerticalAlignment="Center"
                              Margin="5"/>
            </StackPanel>
            <!-- Status line (file loaded, output path picked, run result) -->
            <TextBlock Text="{x:Bind PageVm.ContentText, Mode=OneWay}"
                       Margin="5"
                       Foreground="Gray"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind PageVm.TokenInfo, Mode=OneWay}"
                       Margin="5,0,5,0"
                       Foreground="Gray"
                       FontStyle="Italic"/>

            <!-- Display area for the actual prose -->
            <TextBlock Text="Story Content:" FontWeight="Bold" Margin="5"/>
            <ScrollViewer Height="150" Margin="5" VerticalScrollBarVisibility="Auto">
                <TextBox Text="{x:Bind PageVm.StoryText, Mode=TwoWay}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>

            <!-- AI Output Display (read‑only now) -->
            <TextBlock Text="AI Output:" FontWeight="Bold" Margin="5,10,0,0"/>
            <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                <TextBox
                    Text="{x:Bind PageVm.ChatHistoryText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    IsReadOnly="True"
                    Background="Transparent"
                    BorderThickness="0"/>
            </ScrollViewer>

            <!-- Feedback panel (visible after a successful outline) -->
            <StackPanel Orientation="Vertical"
                        Margin="5,15,5,5"
                        Padding="10"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Visibility="{x:Bind PageVm.FeedbackVisibility, Mode=OneWay}">
                <TextBlock Text="How was this outline?" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{x:Bind PageVm.UserFeedback, Mode=TwoWay}"
                         PlaceholderText="Optional comments..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="60"
                         Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Content="Open in StoryCAD" Command="{x:Bind PageVm.OpenInStoryCadCommand}"/>
                    <Button Content="👍 Thumbs Up"   Command="{x:Bind PageVm.ThumbsUpCommand}"/>
                    <Button Content="👎 Thumbs Down" Command="{x:Bind PageVm.ThumbsDownCommand}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{x:Bind PageVm.FeedbackStatus, Mode=OneWay}"
                       Margin="5,5,0,0"
                       Foreground="Green"
                       FontStyle="Italic"/>

        </StackPanel>
</Page>

