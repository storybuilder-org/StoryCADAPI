<Page x:Class="StoryCADCritter.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="20" Spacing="12" MaxWidth="700">

            <TextBlock Text="StoryCAD Critter" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Per-element critique walk over a StoryCAD outline."
                       Foreground="Gray" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Pick Outline (.stbx)…"
                        Command="{x:Bind Vm.PickOutlineCommand}"/>
                <TextBlock Text="{x:Bind Vm.OutlinePathDisplay, Mode=OneWay}"
                           Foreground="Gray" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Pick Output Folder…"
                        Command="{x:Bind Vm.PickOutputFolderCommand}"/>
                <TextBlock Text="{x:Bind Vm.OutputFolderDisplay, Mode=OneWay}"
                           Foreground="Gray" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Run Critique"
                        Command="{x:Bind Vm.RunCommand}"/>
                <Button Content="Cancel"
                        Command="{x:Bind Vm.CancelCommand}"
                        Visibility="{x:Bind Vm.CancelVisibility, Mode=OneWay}"/>
                <ProgressRing IsActive="{x:Bind Vm.IsRunning, Mode=OneWay}"
                              Width="24" Height="24" VerticalAlignment="Center"/>
            </StackPanel>

            <Border BorderBrush="Gray" BorderThickness="1"
                    Padding="10" Margin="0,8,0,0">
                <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock Text="Progress" FontWeight="SemiBold"/>
                    <ProgressBar Minimum="0"
                                 Maximum="{x:Bind Vm.ProgressTotal, Mode=OneWay}"
                                 Value="{x:Bind Vm.ProgressDone, Mode=OneWay}"
                                 Height="20"/>
                    <TextBlock Text="{x:Bind Vm.ProgressLabel, Mode=OneWay}"
                               Foreground="Gray"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                       Foreground="Gray" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="10"
                        Visibility="{x:Bind Vm.ResultsVisibility, Mode=OneWay}">
                <Button Content="Open Report"
                        Command="{x:Bind Vm.OpenReportCommand}"/>
                <Button Content="Open Output Folder"
                        Command="{x:Bind Vm.OpenOutputFolderCommand}"/>
            </StackPanel>

            <TextBlock Text="Log:" FontWeight="Bold" Margin="0,10,0,0"/>
            <ScrollViewer x:Name="LogScrollViewer" Height="240" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogTextBox"
                         Text="{x:Bind Vm.LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         TextChanged="LogTextBox_TextChanged"/>
            </ScrollViewer>

        </StackPanel>
    </ScrollViewer>
</Page>
